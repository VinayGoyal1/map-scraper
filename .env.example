# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/business_extractor

# Run the browser invisibly (true) or show a window so you can watch it (false).
HEADLESS=true

# How long to wait for Google Maps to load a place page (milliseconds).
NAV_TIMEOUT_MS=30000
PLAYWRIGHT_TIMEOUT_MS=45000

# How many extractions may run at the same time. Keep this low.
EXTRACT_MAX_CONCURRENCY=2

# Timeout for fetching a business website while looking for an email.
HTTP_TIMEOUT_SECONDS=12

# Comma separated list of allowed CORS origins ("*" allows everything).
CORS_ORIGINS=*

LOG_LEVEL=INFO
